---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const showDrafts = import.meta.env.DEV;
const posts = (await getCollection('posts', ({ data }) => showDrafts || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Blog">
  <div class="container page">
    <div class="prose">
      <header class="page-head">
        <span class="section-eyebrow">Blog</span>
        <h1>Blog</h1>
      </header>
      {posts.length === 0 && <p class="lede">No Blogs Yet</p>}
      <ul class="entries">
        {posts.map((p) => (
          <li>
            {p.data.draft && <span class="draft-note">Draft: hidden on live site</span>}
            <a class="entry-title" href={`/posts/${p.id}/`}>{p.data.title}</a>
            <div class="meta">
              <time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
            </div>
            <p class="entry-detail">{p.data.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>

<style>
  .lede {
    color: var(--ink-soft);
    font-size: 1.25rem;
  }
</style>
