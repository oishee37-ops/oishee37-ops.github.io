---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const showDrafts = import.meta.env.DEV;
  const items = await getCollection('research', ({ data }) => showDrafts || !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const meta = [item.data.affiliation, item.data.period].filter(Boolean).join(' · ');
---

<Base title={item.data.title}>
  <div class="container page">
    <article class="prose">
      {item.data.draft && <p class="draft-note">Draft: this page is hidden on the live site</p>}
      <header class="page-head">
        <a class="meta back" href="/research/">← Research &amp; Projects</a>
        <h1>{item.data.title}</h1>
        {meta && <p class="entry-detail">{meta}</p>}
      </header>
      <Content />
    </article>
  </div>
</Base>

<style>
  .back {
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
</style>
