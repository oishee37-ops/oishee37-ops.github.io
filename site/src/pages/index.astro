---
import Base from '../layouts/Base.astro';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Oishee Rahman',
  url: 'https://oishee37-ops.github.io',
  image: 'https://oishee37-ops.github.io/images/profile/oishee-rahman.jpg',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Dhaka' },
  sameAs: ['https://www.linkedin.com/in/oishee-rahman'],
};
---

<Base title="Oishee Rahman" ogImage="/images/profile/oishee-rahman.jpg" jsonLd={personJsonLd}>
  <div class="container page">
    <section class="hero">
      <div class="hero-eyebrow">
        <span class="amber-dot"></span>
        <span class="label">Researcher · Dhaka, Bangladesh</span>
      </div>

      <div class="hero-content">
        <div class="hero-text">
          <h1 class="hero-name">
            Oishee<br />
            <em class="name-accent">Rahman</em>
          </h1>
          <p class="hero-bio">
            Researcher working on Bangladesh's renewable energy transition, with a
            focus on agrivoltaics, regulation and inclusive energy access. Completed
            BSc and MS in Applied Chemistry and Chemical Engineering at University of
            Dhaka. Participant of Shoktikonna Leadership Cohort 2025.
          </p>
          <div class="hero-tags">
            <span class="tag">Just Transition</span>
            <span class="tag">Energy Policy</span>
            <span class="tag">Sustainable Materials</span>
          </div>
        </div>
        <div class="hero-photo">
          <img src="/images/profile/oishee-rahman.jpg" alt="Oishee Rahman" width="400" height="400" />
        </div>
      </div>
    </section>

    <section class="section general-info">
      <h2>General Info</h2>
      <dl class="info">
        <div class="info-row"><dt>Based in</dt><dd>Dhaka, Bangladesh</dd></div>
        <div class="info-row"><dt>Experience</dt><dd>GIZ Bangladesh, Green Energy Transition–Policy Advisory Partnership (2026)</dd></div>
        <div class="info-row"><dt>Education</dt><dd>MS &amp; BSc, Applied Chemistry and Chemical Engineering, University of Dhaka</dd></div>
      </dl>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-top: var(--space-2);
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .amber-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--solar);
    flex-shrink: 0;
    display: inline-block;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
    margin-bottom: 0;
  }
  @media (max-width: 600px) {
    .hero-content { grid-template-columns: 1fr; }
  }

  .hero-name {
    font-family: 'Cormorant', serif;
    font-size: clamp(2.8rem, 7vw, 5rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }

  .name-accent {
    color: var(--forest);
    font-style: normal;
  }

  .hero-bio {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 440px;
    margin-bottom: 24px;
  }

  .hero-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag {
    font-family: 'Jost', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--tag-bg);
    color: var(--tag-fg);
    padding: 5px 14px;
    border-radius: 20px;
    border: 0;
    margin: 0;
  }

  .hero-photo img {
    width: clamp(220px, 26vw, 320px);
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 18px;
    border: 3px solid var(--surface);
    box-shadow: 0 18px 40px -18px rgba(26, 58, 46, 0.45), 0 0 0 1px var(--border);
  }

  /* General Info */
  .info {
    margin: 0;
  }
  .info-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
  }
  .info dt {
    font-family: 'Jost', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
    padding-top: 0.15rem;
  }
  .info dd {
    margin: 0;
    color: var(--fg);
    font-size: 0.92rem;
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px) {
    .info-row { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
