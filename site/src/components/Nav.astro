---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/research/', label: 'Research & Projects' },
  { href: '/publications/', label: 'Publications' },
  { href: '/experience/', label: 'Experience' },
  { href: '/posts/', label: 'Blog' },
];
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (target: string) =>
  target === '/' ? pathname === '/' : pathname === target || pathname.startsWith(target + '/');
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand"><span>Oishee</span> <span>Rahman</span></a>
    <ul>
      {links.map((link) => {
        const target = link.href.replace(/\/$/, '') || '/';
        const active = isActive(target);
        return (
          <li><a href={link.href} class={active ? 'active' : ''}>{link.label}</a></li>
        );
      })}
    </ul>
  </div>
</nav>

<style>
  .nav {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .brand {
    font-family: 'Cormorant', serif;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--fg);
    line-height: 1;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
  }
  ul a {
    display: inline-block;
    font-family: 'Jost', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    padding: 8px 12px;
    border-radius: 6px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  ul a:hover {
    color: var(--fg);
    background: transparent;
  }
  ul a.active {
    background: var(--tag-bg);
    color: var(--forest);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .nav { position: static; }
    .nav-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    ul {
      justify-content: flex-start;
      margin-left: -12px;
    }
    ul a {
      font-size: 0.7rem;
      padding: 7px 10px;
    }
  }
</style>
